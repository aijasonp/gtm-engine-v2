# Copy to .env and fill in. Never commit .env.
# Model gateway
ANTHROPIC_API_KEY=
COMPANY_API_KEY=            # optional OpenAI-compatible gateway
# Decision-model scoring engines (see core/references/scoring-engines-clef.md)
TYPESAFE_BACKEND=clef
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
# CRM
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=
# Enrichment and sequencing
CLAY_API_KEY=
FLOQER_API_KEY=
LEADIQ_API_KEY=
MOLTSETS_API_KEY=
MOLTSETS_RECORDS_FLOOR=25     # reachability gate stops spending under this many 5h records
APIFY_TOKEN=                  # competitor-engagers and reddit-signals
SMARTLEAD_API_KEY=
LEMLIST_API_KEY=
# Calls and meetings
GRANOLA_API_KEY=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REFRESH_TOKEN=
AIRCALL_API_ID=
AIRCALL_API_TOKEN=
PHONE_DNC_FILES=              # colon-separated DNC hash files for phone-compliance (keep outside the repo)
# Workspace
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
NOTION_API_KEY=
LINEAR_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_FILE=  # optional, headless sheet builds
FORECAST_SHEET_ID=
# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Local data
GTM_DATA_DIR=                 # default ~/.gtm/data (gate cache, signal databases)
